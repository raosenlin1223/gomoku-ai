/* 天天玩*五子棋 - 页面样式（全功能增强版） */

/* ====== 容器 ====== */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx 40rpx;
  min-height: 100vh;
  position: relative;
}

/* ====== 标题区 ====== */
.header {
  text-align: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  background: linear-gradient(135deg, #f5d061, #e8c170, #d4a840, #f5d061);
  background-size: 300% 300%;
  -webkit-background-clip: text;
  color: #f5d061;
  display: block;
  animation: shimmer 4s ease-in-out infinite;
}

@keyframes shimmer {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

.subtitle {
  font-size: 22rpx;
  color: #7780aa;
  margin-top: 8rpx;
  display: block;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

/* ====== 控制面板 ====== */
.panel {
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 16rpx 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 90%;
  justify-content: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.25),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.panel-label {
  font-size: 28rpx;
  color: #aaaacc;
  font-weight: 500;
}

.picker-text {
  padding: 10rpx 40rpx 10rpx 16rpx;
  font-size: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #e8e8e8;
  position: relative;
  transition: background 0.2s;
}

.picker-text:active {
  background: rgba(255, 255, 255, 0.14);
}

.picker-text::after {
  content: "▼";
  position: absolute;
  right: 14rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: #aaaacc;
}

/* ====== 音效开关 ====== */
.sound-toggle {
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  transition: background 0.2s;
}

.sound-toggle:active {
  background: rgba(255, 255, 255, 0.16);
}

.sound-icon {
  font-size: 30rpx;
  line-height: 1;
}

/* ====== 信息条 ====== */
.info-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  margin-bottom: 18rpx;
  min-height: 40rpx;
}

.turn-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 34rpx;
  font-weight: 500;
}

.stone-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  display: inline-block;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}

.dot-black {
  background: radial-gradient(circle at 35% 35%, #666, #111);
}

.dot-white {
  background: radial-gradient(circle at 35% 35%, #fff, #c8c8c8);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.turn-text {
  font-size: 30rpx;
}

.ai-badge {
  font-size: 24rpx;
  color: #e8c170;
  animation: pulse 1.2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

/* ====== 棋盘 ====== */
.board-container {
  position: relative;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.55),
              0 0 0 3rpx rgba(180, 140, 60, 0.45),
              0 0 0 6rpx rgba(80, 50, 10, 0.3),
              inset 0 0 20rpx rgba(0, 0, 0, 0.15);
}

.board-canvas {
  display: block;
}

/* ====== 胜利遮罩 ====== */
.overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(8, 8, 24, 0.88);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border-radius: 14rpx;
  z-index: 10;
}

.overlay-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overlay-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  color: #f5d061;
  letter-spacing: 2rpx;
}

.overlay-sub {
  font-size: 30rpx;
  color: #aaaacc;
  margin-bottom: 32rpx;
}

.overlay-btn {
  padding: 14rpx 48rpx;
  font-size: 32rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #f5d061, #c9952f);
  color: #1a1a2e;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(201, 149, 47, 0.45);
  transition: transform 0.15s;
}

.overlay-btn:active {
  transform: scale(0.95);
}

@keyframes celebrate {
  0% { transform: scale(0.7); opacity: 0; }
  50% { transform: scale(1.06); }
  100% { transform: scale(1); opacity: 1; }
}

.celebrate {
  animation: celebrate 0.5s ease-out;
}

/* ====== 状态栏 ====== */
.status-area {
  margin-top: 18rpx;
  text-align: center;
  min-height: 30rpx;
}

.status-text {
  font-size: 38rpx;
  font-weight: 600;
}

.status-text.win {
  color: #f5d061;
  animation: pulse 1.2s ease-in-out infinite;
}

.move-count {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666688;
  display: block;
}

/* ====== 按钮组 ====== */
.btn-group {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
}

.btn-group-secondary {
  margin-top: 12rpx;
}

.btn {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  border-radius: 12rpx;
  font-weight: 500;
  text-align: center;
  transition: transform 0.15s, opacity 0.15s;
  line-height: 1.4;
}

.btn:active {
  transform: scale(0.94);
  opacity: 0.85;
}

.btn-restart {
  background: linear-gradient(135deg, #f5d061, #c9952f);
  color: #1a1a2e;
  font-weight: 600;
  box-shadow: 0 3rpx 12rpx rgba(201, 149, 47, 0.35);
}

.btn-undo {
  background: rgba(255, 255, 255, 0.08);
  color: #ccc;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.btn-hint {
  background: rgba(0, 180, 255, 0.15);
  color: #00b4ff;
  border: 1rpx solid rgba(0, 180, 255, 0.3);
}

.btn-record {
  background: rgba(255, 255, 255, 0.08);
  color: #ccc;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.btn-stats {
  background: rgba(255, 255, 255, 0.08);
  color: #ccc;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.btn-share {
  background: rgba(0, 200, 120, 0.15);
  color: #00c878;
  border: 1rpx solid rgba(0, 200, 120, 0.3);
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 12rpx;
  line-height: normal;
}

.btn-share::after {
  border: none;
}

/* ====== 模态遮罩 ====== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 85%;
  max-height: 80vh;
  background: #1e1e36;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.55),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  animation: modalIn 0.25s ease-out;
}

@keyframes modalIn {
  0% { transform: scale(0.9); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #f5d061;
}

.modal-close {
  font-size: 28rpx;
  color: #8888aa;
  padding: 10rpx 12rpx;
  border-radius: 8rpx;
  transition: background 0.2s;
}

.modal-close:active {
  background: rgba(255, 255, 255, 0.08);
}

/* ====== 棋谱面板 ====== */
.record-panel {
  /* 棋谱面板暂无额外样式，共用modal-content */
}

.record-list {
  padding: 16rpx 28rpx;
  max-height: 50vh;
  overflow-y: auto;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.record-last {
  background: rgba(255, 60, 60, 0.08);
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
  border-bottom-color: rgba(255, 60, 60, 0.12);
}

.record-num {
  font-size: 26rpx;
  color: #8888aa;
  min-width: 44rpx;
  text-align: right;
}

.record-player {
  font-size: 26rpx;
  font-weight: 600;
  min-width: 36rpx;
}

.player-black {
  color: #e8e8e8;
}

.player-white {
  color: #b8b8b8;
}

.record-pos {
  font-size: 26rpx;
  color: #aaaacc;
  font-weight: 500;
}

.record-empty {
  text-align: center;
  color: #666688;
  font-size: 26rpx;
  padding: 48rpx 0;
}

.record-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.btn-export {
  background: rgba(255, 255, 255, 0.08);
  color: #ccc;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 10rpx;
  transition: transform 0.15s;
}

.btn-export:active {
  transform: scale(0.94);
}

.record-total {
  font-size: 26rpx;
  color: #8888aa;
}

/* ====== 统计面板 ====== */
.stats-panel {
  /* 统计面板暂无额外样式，共用modal-content */
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  padding: 28rpx 20rpx;
}

.stats-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 14rpx;
  min-width: 130rpx;
  transition: transform 0.2s;
}

.stats-win {
  background: rgba(0, 200, 120, 0.12);
  border: 1rpx solid rgba(0, 200, 120, 0.2);
}

.stats-lose {
  background: rgba(255, 60, 60, 0.12);
  border: 1rpx solid rgba(255, 60, 60, 0.2);
}

.stats-draw {
  background: rgba(200, 200, 100, 0.12);
  border: 1rpx solid rgba(200, 200, 100, 0.2);
}

.stats-total {
  background: rgba(100, 150, 255, 0.12);
  border: 1rpx solid rgba(100, 150, 255, 0.2);
}

.stats-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #f5d061;
}

.stats-win .stats-num { color: #00c878; }
.stats-lose .stats-num { color: #ff4444; }
.stats-draw .stats-num { color: #cccc44; }
.stats-total .stats-num { color: #6699ff; }

.stats-label {
  font-size: 24rpx;
  color: #8888aa;
  margin-top: 8rpx;
}

/* ====== 胜率条 ====== */
.stats-rate {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 28rpx;
}

.rate-label {
  font-size: 26rpx;
  color: #8888aa;
  min-width: 60rpx;
}

.rate-bar {
  flex: 1;
  height: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.rate-fill {
  height: 100%;
  background: linear-gradient(135deg, #00c878, #00a060);
  border-radius: 10rpx;
  transition: width 0.4s ease;
  box-shadow: 0 0 8rpx rgba(0, 200, 120, 0.3);
}

.rate-text {
  font-size: 26rpx;
  color: #00c878;
  font-weight: 600;
  min-width: 80rpx;
  text-align: right;
}

.stats-footer {
  display: flex;
  justify-content: center;
  padding: 18rpx 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.btn-clear-stats {
  background: rgba(255, 60, 60, 0.08);
  color: #ff6666;
  border: 1rpx solid rgba(255, 60, 60, 0.15);
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 10rpx;
  transition: transform 0.15s;
}

.btn-clear-stats:active {
  transform: scale(0.94);
}

/* ====== 页脚 ====== */
.footer {
  margin-top: 32rpx;
  color: #555577;
  font-size: 22rpx;
  letter-spacing: 3rpx;
}

/* ====== 暗色滚动条适配 ====== */
::-webkit-scrollbar {
  width: 6rpx;
}

::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.2);
}

::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 3rpx;
}
